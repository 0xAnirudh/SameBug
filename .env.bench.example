# Benchmark environment. Copy to .env.bench.
#
# Two things here are deliberate:
#
# 1. A LOCAL mongod, not Atlas. The Atlas free tier is shared and CPU throttled,
#    so benchmarking it measures someone else's noise. If you have no local
#    MongoDB, the binary mongodb-memory-server already downloaded works:
#
#      ~/.cache/mongodb-binaries/mongod-* --dbpath /tmp/mongo-bench --port 27018
#
# 2. A SEPARATE Redis database. The load test leaves hundreds of thousands of
#    buffered view counts behind; sharing db 0 with development means your dev
#    server's flusher then spends minutes draining slugs that only ever existed
#    in the benchmark dataset.

NODE_ENV=production
PORT=4100

MONGO_URI=mongodb://127.0.0.1:27018/samebug-bench
REDIS_URL=redis://127.0.0.1:6379/1

JWT_ACCESS_SECRET=benchmark-only-secret-at-least-32-chars
JWT_REFRESH_SECRET=benchmark-only-refresh-secret-32-chars

# The one variable the read-path experiment changes.
CACHE_ENABLED=false
CACHE_TTL_SECONDS=3600

# The one variable the view-counter experiment changes.
VIEW_BUFFER_ENABLED=true
VIEW_FLUSH_INTERVAL_MS=30000

# Off: a limiter would throttle the load test and measure itself.
RATE_LIMIT_ENABLED=false

LOG_LEVEL=warn
