# Copy to .env and fill in. .env is gitignored; this file never holds real values.
NODE_ENV=development
PORT=4100

# Stores
MONGO_URI=mongodb://localhost:27017/samebug
REDIS_URL=redis://localhost:6379

# Auth — generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-me-with-at-least-32-characters-of-entropy
JWT_REFRESH_SECRET=replace-me-with-a-different-32-plus-character-secret
ACCESS_TTL=15m
REFRESH_TTL=7d

# Cache. The whole before/after benchmark is this one flag.
CACHE_ENABLED=false
CACHE_TTL_SECONDS=3600

# View counter buffer
VIEW_FLUSH_INTERVAL_MS=30000

# Limits
MAX_PASTE_BYTES=1048576

# Client
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info

# Phase 6
VIEW_BUFFER_ENABLED=true
VIEW_FLUSH_BATCH=500
RATE_LIMIT_ENABLED=true
